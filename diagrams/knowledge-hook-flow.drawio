          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eb-gate-prep" value="gate off" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="phaseB" source="b-gate" target="b-prep">
          <mxGeometry relative="1" as="geometry" />

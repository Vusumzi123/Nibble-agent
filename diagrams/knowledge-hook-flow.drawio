        <mxCell id="legend" value="Legend" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#888888;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="3470" width="1100" height="140" as="geometry" />

<mxfile host="app.diagrams.net" agent="diagram-developer" version="24.0.0">
  <diagram id="knowledge-hook-flow" name="knowledge-hook-flow">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="3900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="knowledge-hook flow (capture + consolidation)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1100" height="45" as="geometry" />
        </mxCell>

        <mxCell id="phaseA" value="Phase A &#8212; Capture (deterministic, no LLM)" style="swimlane;startSize=40;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#888888;verticalAlign=middle;fontStyle=1;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="1040" height="1020" as="geometry" />
        </mxCell>

        <mxCell id="a-start" value="chat.message hook fires" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="phaseA">
          <mxGeometry x="60" y="40" width="400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a-child" value="child session?&#xa;(parentID set / in automationChildSessions)&#xa;or plugin disabled" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="phaseA">
          <mxGeometry x="60" y="150" width="400" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a-skip" value="silent return" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="phaseA">
          <mxGeometry x="560" y="165" width="380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a-track" value="track active session &#8594; push prior session to superseded&#xa;stash pending user text (state file)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="phaseA">
          <mxGeometry x="60" y="320" width="400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a-idle" value="session.idle hook fires&#xa;(skip drain-child idle: resolve waiter instead; skip child/disabled)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="phaseA">
          <mxGeometry x="60" y="460" width="400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a-capture" value="captureTurn: fetch last assistant reply + user text&#xa;(return if none / already captured)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="phaseA">
          <mxGeometry x="60" y="600" width="400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a-append" value="append numbered &lt;!-- turn: N --&gt; block&#xa;Brain/Raw/&lt;sanitized-sessionID&gt;.md&#xa;(rolls to -partN.md above chunk_bytes)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="phaseA">
          <mxGeometry x="60" y="740" width="400" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a-mark" value="mark captured + consume pending text (only after successful append)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="phaseA">
          <mxGeometry x="60" y="900" width="400" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ea-start-child" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="phaseA" source="a-start" target="a-child">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ea-child-skip" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="phaseA" source="a-child" target="a-skip">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ea-child-track" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="phaseA" source="a-child" target="a-track">
          <mxGeometry relative="1" as="geometry" />

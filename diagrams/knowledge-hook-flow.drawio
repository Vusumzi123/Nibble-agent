        <mxCell id="eb-gate-gateskip" value="gate on" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="phaseB" source="b-gate" target="b-gateskip">
          <mxGeometry relative="1" as="geometry" />

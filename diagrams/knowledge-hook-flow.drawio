          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="ea-b" value="capture done" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="a-mark" target="b-list">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="phaseB" value="Phase B &#8212; Consolidation (async, one rag-brain child)" style="swimlane;startSize=40;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#888888;verticalAlign=middle;fontStyle=1;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="1240" width="1040" height="2180" as="geometry" />
        </mxCell>

        <mxCell id="b-list" value="drainIfNeeded: list Brain/Raw/ &#8594; isEligible&#xa;(turns &gt;= threshold_turns OR superseded; active session never drained)&#xa;then triageEligible: classifyTranscript; modelEligible on reason == non-trivial-turn" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="phaseB">
          <mxGeometry x="60" y="40" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="b-elig" value="eligible?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="phaseB">
          <mxGeometry x="60" y="180" width="400" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b-return" value="return (no eligible raw / cooling down)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="phaseB">
          <mxGeometry x="560" y="190" width="380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b-trivial" value="unambiguously trivial?&#xa;(skip_triage / classifyTranscript)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="phaseB">
          <mxGeometry x="60" y="330" width="400" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b-prefilter" value="deleteGuarded &#8594; event prefilter-skip&#xa;(all trivial &#8594; stop)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="phaseB">
          <mxGeometry x="560" y="345" width="380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b-cooldown" value="cooldown elapsed?&#xa;(now - lastDrainAt &gt;= drain_cooldown_ms)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="phaseB">
          <mxGeometry x="60" y="480" width="400" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b-batch" value="selectDrainBatch&#xa;(batch_cap count &#215; drain_max_tokens; oversized single session drains alone)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="phaseB">
          <mxGeometry x="60" y="630" width="400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b-gate" value="gateBatch: decideWithFallback per modelEligible&#xa;(only when decisions.mode == gate &amp; skip_triage;&#xa;decisions.log written by jev-hook)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6d0ff;strokeColor=#7b3fe4;strokeWidth=3;fontStyle=1;" vertex="1" parent="phaseB">
          <mxGeometry x="60" y="760" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="b-gateskip" value="confident, non-fallback&#xa;gate skip? (pTrue &gt;= noul_threshold)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="phaseB">
          <mxGeometry x="60" y="900" width="400" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b-gatelog" value="deleteGuarded &#8594; event gate-skip&#xa;(all gated out &#8594; event gate-skip-all, stop)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="phaseB">
          <mxGeometry x="560" y="915" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b-prep" value="preparePromptSessions: extractAtoms digest +&#xa;extractKeywords/findCandidateNotes (when inline_transcripts)&#xa;&#8594; buildDrainPrompt" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="phaseB">
          <mxGeometry x="60" y="1050" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="b-spawn" value="spawnDrainChild &#8594; one rag-brain child&#xa;(registered in automationChildSessions)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6d0ff;strokeColor=#7b3fe4;strokeWidth=3;fontStyle=1;" vertex="1" parent="phaseB">
          <mxGeometry x="60" y="1190" width="400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b-wait" value="waitForChildIdle (180s timeout)&#xa;&#8594; getChildReply (LAST assistant text)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="phaseB">
          <mxGeometry x="60" y="1320" width="400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b-reply" value="reply present?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="phaseB">
          <mxGeometry x="60" y="1450" width="400" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b-noreply" value="event drain-no-reply / drain-timeout&#xa;(raw kept, surfaced once)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="phaseB">
          <mxGeometry x="560" y="1465" width="380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b-verify" value="verification issues?&#xa;(blockingIssues(takeIssues(childID)) from write guard)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="phaseB">
          <mxGeometry x="60" y="1600" width="400" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b-vblock" value="retain raw files &#8594; event drain-verification-blocked&#xa;(stop; retry later)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="phaseB">
          <mxGeometry x="560" y="1615" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b-parse" value="parse fences: parseConsolidated / parseSkipped +&#xa;recoverMislabeledConsolidated &#8594; done = consolidated &#8746; skipped" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="phaseB">
          <mxGeometry x="60" y="1750" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="b-done" value="fence done?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="phaseB">
          <mxGeometry x="60" y="1890" width="400" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b-failed" value="files in neither fence = failed&#xa;(kept for retry, surfaced once)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="phaseB">
          <mxGeometry x="560" y="1905" width="380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b-final" value="deleteGuarded succeeded (mid-drain append &#8594; late-append-retained)&#xa;NDJSON event drain &#8594; knowledge-hook.log (batch/tokens/cost/outcome)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="phaseB">
          <mxGeometry x="60" y="2040" width="400" height="90" as="geometry" />
        </mxCell>

        <mxCell id="eb-list-elig" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="phaseB" source="b-list" target="b-elig">

          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eb-verify-vblock" value="issues" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="phaseB" source="b-verify" target="b-vblock">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eb-verify-parse" value="clean" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="phaseB" source="b-verify" target="b-parse">

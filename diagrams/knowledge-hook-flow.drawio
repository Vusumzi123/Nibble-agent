        </mxCell>
        <mxCell id="leg-llm" value="LLM / model call" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6d0ff;strokeColor=#7b3fe4;strokeWidth=3;fontStyle=1;" vertex="1" parent="legend">
          <mxGeometry x="370" y="55" width="165" height="55" as="geometry" />
        </mxCell>
        <mxCell id="leg-dec" value="decision" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="legend">
          <mxGeometry x="545" y="52" width="165" height="60" as="geometry" />
        </mxCell>
        <mxCell id="leg-art" value="raw file / vault artifact" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="legend">
          <mxGeometry x="720" y="50" width="165" height="65" as="geometry" />
        </mxCell>
        <mxCell id="leg-log" value="log / terminal side-effect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="legend">
          <mxGeometry x="895" y="55" width="185" height="55" as="geometry" />
        </mxCell>

        <mxCell id="crosscut" value="&lt;b&gt;Cross-cutting&lt;/b&gt;&#xa;fail-open: a model error, abstain, or fallback verdict never skips a session (only confident non-fallback &quot;trivial&quot; gate skips do).&#xa;L1 determinism: capture, triage, batching, parsing, deletion and the turn-count watermark are all deterministic code; the model only ever acts inside the rag-brain drain child and the optional gate.&#xa;deterministic triage runs before the cooldown gate (it is free); the gate runs only after the cooldown gate (model consulted only when a drain is about to happen)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fillColor=#fffde7;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="3630" width="1100" height="110" as="geometry" />
        </mxCell>

    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@vusux/phosphorstrap": "file:vendor/phosphorstrap",
    "bootstrap": "^5.3.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.0",
    "typescript": "~6.0.2"
  }

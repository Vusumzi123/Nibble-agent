# ===== Deny-list: keep local/personal files out of the public repo =====

# Personal vault + machine-specific setup (generated by setup.sh)
Brain/
SETUP.md

# Local design notes — not part of the public push
# (public exceptions: the autonomy-integration contract, the sysop-config
#  reference, the lane-queue architecture + producer guide, the drain
#  consumer contract, and the SWRR scheduler plan)
docs/*
!docs/autonomy-integration.md
!docs/sysop-config-reference.md
!docs/heartbeat-lanes.md
!docs/drain-consumer.md
!docs/swrr-work-scheduler-plan.md

# Kanban board (personal project management, local only)
Boards/

# Local config with personal values (generated from example, setup.sh)
.opencode/sysop-config.yaml

# Transient state (raw conversation memory — may contain secrets; never commit)
.opencode/state/

# Audit trail + structured hook logs (project-local, never commit)
.opencode/logs/

# Secrets / env
.env
.env.*
*.log

# Build & runtime artifacts
node_modules/
dist/
# The dashboard vendors its Phosphorstrap dist (source dependency, not a build artifact).
!Dashboard/vendor/phosphorstrap/dist/
!Dashboard/vendor/phosphorstrap/dist/**
__pycache__/
*.pyc
.temp/
.vscode/

# Pinned markdown-vault MCP — cloned at a pinned SHA and built by setup.sh
# (source, deps and dist/ are all regenerated, never vendored). The pin itself
# lives in scripts/setup.sh (MCP_SHA).
.opencode/mcp/

# Editor / OS junk
*.kate-swp
.scrt*
.DS_Store
Thumbs.db

# Vault churn
.obsidian/
.trash/

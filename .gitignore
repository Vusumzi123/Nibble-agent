# ===== Deny-list: keep local/personal files out of the public repo =====

# Personal vault + machine-specific setup (generated by setup.sh)
Brain/
SETUP.md

# Local design notes — not part of the public push
docs/

# Local config with personal values (generated from example, setup.sh)
.opencode/sysop-config.yaml

# Transient state (raw conversation memory — may contain secrets; never commit)
.opencode/state/

# Audit trail + structured hook logs (project-local, never commit)
.opencode/logs/

# Secrets / env
.env
.env.*
*.log

# Build & runtime artifacts
node_modules/
dist/
__pycache__/
*.pyc
.temp/
.vscode/

# Pinned markdown-vault MCP — cloned at a pinned SHA and built by setup.sh
# (source, deps and dist/ are all regenerated, never vendored). The pin itself
# lives in scripts/setup.sh (MCP_SHA).
.opencode/mcp/

# Editor / OS junk
*.kate-swp
.scrt*
.DS_Store
Thumbs.db

# Vault churn
.obsidian/
.trash/
